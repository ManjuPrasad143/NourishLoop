# Local development defaults. Copy this file to .env before starting Docker Compose.
# These credentials are for local development only; replace them before deployment.

# Database (PostgreSQL/PostGIS)
DATABASE_HOST=postgres
DATABASE_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=surplus_db
POSTGRES_PORT=5432
# DB_SSL=false

# Redis (host port is for local tools; the backend uses port 6379 inside Docker)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_TLS=false
# REDIS_URL=

# Authentication
JWT_SECRET=local-only-change-before-deployment

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# Local pgAdmin login
PGADMIN_EMAIL=admin@surplussync.com
PGADMIN_PASSWORD=local-only-change-before-deployment

# First local admin account
SUPER_ADMIN_EMAIL=admin@surplussync.com
SUPER_ADMIN_PASSWORD=local-only-change-before-deployment

# Optional Cloudinary credentials (without these, image uploads use mock URLs)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional email delivery (without these, emails are logged locally)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@surplussync.app

# Optional for Docker Compose; Compose sets this for the frontend service.
# VITE_API_URL=http://localhost:3000